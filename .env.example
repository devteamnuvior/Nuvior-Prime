# NUVIOR Prime — local development
DATABASE_URL="postgresql://nuvior:nuvior@localhost:5432/nuvior_prime?schema=public"

# Places provider: mock | google
PLACES_PROVIDER="mock"
# Server-only (never NEXT_PUBLIC_). Routes / Geocoding / Places web services.
GOOGLE_MAPS_SERVER_KEY=""
# Legacy aliases if GOOGLE_MAPS_SERVER_KEY is empty:
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_MAX_SEARCHES_PER_RUN="24"
GOOGLE_PLACES_CACHE_TTL_SECONDS="86400"
GOOGLE_PLACES_FETCH_DETAILS="true"

# Phase 3 enrichment
ENRICHMENT_ENABLED="true"
ENRICHMENT_MAX_ACCOUNTS="5"
ENRICHMENT_MAX_PAGES_PER_ACCOUNT="4"
ENRICHMENT_MAX_REQUESTS="30"
ENRICHMENT_TIMEOUT_MS="8000"
ENRICHMENT_MAX_BYTES="500000"
ENRICHMENT_CACHE_TTL_SECONDS="86400"
ENRICHMENT_FORCE_REFRESH="false"
# When true (or PLACES_PROVIDER=mock), use fixture HTML instead of live HTTP
ENRICHMENT_USE_FIXTURES=""

# Phase 8.6 Google Maps — browser vs server keys (never mix)

# Browser-only (HTTP-referrer restricted). Maps JS + browser Places.
# Preferred name:
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Legacy alias (still accepted if BROWSER_KEY is empty):
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Maps Demo Key for local development (no billing). Used only when the live
# key above is empty. Get one at https://developers.google.com/maps/documentation/javascript/demo-key
# Never treat this as production-ready. Do not use the watermarked
# "For development purposes only" Maps JS state — that is a billing/API error,
# not a supported mode.
NEXT_PUBLIC_GOOGLE_MAPS_DEMO_KEY=""

# Cloud-styled Map ID (NUVIOR restrained style). Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Phase 8 routing
ROUTING_PROVIDER="geodesic"
# geodesic | mock | google (Routes API — enable Routes API; key may reuse Places)
ROUTE_OPTIMIZATION_ENABLED="true"
ROUTING_MAX_CANDIDATES="40"
ROUTING_MAX_API_CALLS="80"
ROUTING_CACHE_TTL_SECONDS="86400"
ROUTING_TIMEOUT_MS="12000"
ROUTING_TRAFFIC_MODE="traffic_unaware"
ROUTING_DEFAULT_VISIT_MINUTES="20"
ROUTING_REVISIT_VISIT_MINUTES="25"
ROUTING_LUNCH_ENABLED="true"
ROUTING_LUNCH_START="12:00"
ROUTING_LUNCH_END="14:00"
# GOOGLE_ROUTES_API_KEY=""  # optional; falls back to GOOGLE_PLACES_API_KEY

# Phase 4–7 CRM
CRM_PROVIDER="mock"
# mock | unavailable | import | database | api (api is fail-closed until real contract)
CRM_MATCH_AUTO_THRESHOLD="0.9"
CRM_MATCH_POSSIBLE_THRESHOLD="0.6"
CRM_LAST_ORDER_ACTIVE_DAYS="90"
CRM_LAST_ORDER_DORMANT_DAYS="365"
CRM_CACHE_TTL_SECONDS="604800"
CRM_IMPORT_PATH="fixtures/crm"
# CRM_API_BASE_URL=""   # do not invent endpoints; reserved
# CRM_API_TOKEN=""      # server-side only — never commit
# CRM_ALLOW_MOCK_FALLBACK="false"
# CRM_AS_OF_DATE="2026-08-31"
# CRM_UNAVAILABLE="false"

# Phase 6 authentication (Auth.js — local credentials; OIDC later)
AUTH_SECRET="dev-only-change-me-nuvior-prime-phase6"
AUTH_URL="http://localhost:3000"
# AUTH_PROVIDER reserved for future: local | oidc
AUTH_PROVIDER="local"

# Phase 5 LLM (narrative only — never qualification/CRM truth)
LLM_PROVIDER="none"
LLM_ENABLED_FOR_BRIEFS="true"
LLM_MAX_ACCOUNTS_PER_RUN="5"
LLM_CACHE_TTL_SECONDS="86400"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Product catalog (Stage B — server-side only)
PRODUCT_CATALOG_PROVIDER="mock"
# mock | odoo (unavailable until adapter) | unavailable
PRODUCT_CATALOG_CACHE_TTL_SECONDS="3600"
PRODUCT_CATALOG_STALE_AFTER_SECONDS="86400"
# PRODUCT_CATALOG_UNAVAILABLE="false"
# ODOO_BASE_URL=""        # reserved — do not invent endpoints
# ODOO_API_KEY=""         # server-side only — never commit
# ODOO_PASSWORD=""        # server-side only — never commit

# Clinic research / Claude extraction (Stage C — server-side only)
AI_RESEARCH_PROVIDER="mock"
# mock | claude | disabled
AI_RESEARCH_CACHE_TTL_SECONDS="86400"
AI_RESEARCH_STALE_AFTER_SECONDS="604800"
AI_RESEARCH_TIMEOUT_MS="45000"
# ANTHROPIC_API_KEY=""    # server-side only — never commit
# CLAUDE_MODEL="claude-sonnet-4-20250514"
# AI_RESEARCH_UNAVAILABLE="false"