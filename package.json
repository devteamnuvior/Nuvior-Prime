{
  "name": "nuvior-prime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/predeploy.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "validate:toronto": "tsx scripts/validate-toronto.ts",
    "validate:auth": "tsx scripts/validate-auth.ts",
    "validate:crm": "tsx scripts/validate-crm.ts",
    "validate:routing": "tsx scripts/validate-routing.ts",
    "validate:product-catalog": "tsx scripts/validate-product-catalog.ts",
    "validate:clinic-research": "tsx scripts/validate-clinic-research.ts",
    "validate:product-gaps": "tsx scripts/validate-product-gaps.ts",
    "validate:product-opportunities": "tsx scripts/validate-product-opportunities.ts",
    "crm:import": "tsx scripts/crm-import.ts",
    "crm:backfill": "tsx scripts/crm-backfill.ts",
    "postinstall": "prisma generate",
    "live:simulate": "tsx scripts/live-simulate.ts",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "@mui/x-data-grid": "^9.17.0",
    "@prisma/client": "^6.14.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "nextjs-toploader": "^3.9.17",
    "notistack": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
